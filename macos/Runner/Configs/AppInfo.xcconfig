// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// Keep the bundle id (and therefore the existing sandbox container) stable,
// but make the built app and executable user-visible as Particle Library.
PRODUCT_NAME = Particle Library

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = io.github.fkguo.particlelibrary

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Particle Library contributors. Licensed under MPL-2.0.

// Vendored Sparkle.framework (auto-update) lives outside the Runner group.
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(PROJECT_DIR)/Frameworks"
